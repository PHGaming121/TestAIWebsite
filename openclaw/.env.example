# ---------------------------------------------------------------------------
# OpenClaw deployment — secret template
# ---------------------------------------------------------------------------
# Copy to openclaw/.env and fill in real values. NEVER commit the filled copy.
#
#     cp openclaw/.env.example openclaw/.env
#     set -a; source openclaw/.env; set +a
#
# How OpenClaw consumes these: openclaw.json contains ${OPENROUTER_API_KEY}
# and ${OPENCLAW_GATEWAY_TOKEN}; the loader substitutes the environment value
# when the config is read. A committed config file therefore contains no
# credential, and a leaked config file leaks nothing.
#
# Values below are obvious placeholders on purpose — see
# https://docs.openclaw.ai/reference/secret-placeholder-conventions
# ---------------------------------------------------------------------------

# --- Gateway auth ----------------------------------------------------------
# Shared secret every client must present to connect.
# Generate one:  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# scripts/start-gateway.sh generates and stores this automatically on first run
# (into $OPENCLAW_STATE_DIR/.env, mode 600) if it is unset.
OPENCLAW_GATEWAY_TOKEN=example-gateway-token-not-real

# Optional: set a password instead of a token (then use auth mode "password").
# OPENCLAW_GATEWAY_PASSWORD=example-gateway-password-not-real

# --- Model providers -------------------------------------------------------
# One key unlocks many models through OpenRouter's unified API — the fastest
# path to the routing configured in openclaw.json.
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=example-openrouter-key-not-real

# Direct provider keys (optional). Any provider you add to
# agents.defaults.model needs its key present here.
# ANTHROPIC_API_KEY=example-anthropic-key-not-real
# OPENAI_API_KEY=example-openai-key-not-real
# GOOGLE_API_KEY=example-google-key-not-real
# XAI_API_KEY=example-xai-key-not-real

# --- Optional capability keys ---------------------------------------------
# Supplying these lets OpenClaw disable the corresponding plugins cleanly
# instead of logging fetch failures at startup.
# BRAVE_API_KEY=example-brave-key-not-real          # web search
# FIRECRAWL_API_KEY=example-firecrawl-key-not-real  # web fetch / crawl

# --- Runtime tuning (optional) --------------------------------------------
# Faster repeated CLI starts on small hosts (see `openclaw doctor`).
# NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache
# OPENCLAW_NO_RESPAWN=1

# --- Paths (optional) ------------------------------------------------------
# OPENCLAW_STATE_DIR=/var/lib/openclaw
# OPENCLAW_CONFIG_PATH=/etc/openclaw/openclaw.json
