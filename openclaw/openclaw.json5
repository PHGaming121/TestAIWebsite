// ---------------------------------------------------------------------------
// OpenClaw gateway configuration
// ---------------------------------------------------------------------------
// Location at runtime:
//   $OPENCLAW_STATE_DIR/openclaw.json   (default: ~/.openclaw/openclaw.json)
//
// Format: JSON5 (comments + trailing commas allowed).
//
// SECRETS: no credential values live in this file. Every secret is pulled from
// the environment at load time with ${VAR_NAME} substitution, so this file is
// safe to commit. See openclaw/.env.example for the required variables.
//
// VALIDATION: OpenClaw validates this file strictly against its JSON Schema.
// Unknown keys, wrong types, or out-of-range values stop the Gateway from
// booting. Validate before you start:
//     openclaw config validate
// Inspect the canonical schema for any key:
//     openclaw config schema | jq '.properties.gateway'
// ---------------------------------------------------------------------------
{
  // --- Gateway: listener, Control UI, auth --------------------------------
  gateway: {
    mode: "local",

    // Dedicated port for API + Control UI + channel ingress.
    port: 18789,

    // `custom` + 0.0.0.0 exposes every interface. Required when the process is
    // reached through a container/port proxy. Use "loopback" for local-only.
    bind: "custom",
    customBindHost: "0.0.0.0",

    controlUi: {
      enabled: true,

      // Browser origins allowed to open Control UI / WebChat WebSockets.
      // Add your real dashboard origin (e.g. a GitHub Pages domain) here.
      // ["*"] permits any origin and should only be used for throwaway testing.
      // The sandbox entry is the ephemeral live-preview origin; drop it in prod.
      allowedOrigins: [
        "https://phgaming121.github.io",
        "https://18789-iewk7ntauxu7shf3eil87.e2b.app",
      ],
    },

    auth: {
      // "token" requires the shared token below on every connect.
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",

      // Rate limiting / brute-force throttling at the gateway boundary.
      rateLimit: {
        maxAttempts: 10,
        windowMs: 60000,
        lockoutMs: 300000,
        exemptLoopback: true,
      },
    },
  },

  // --- Models: routing, failover, and free-tier preference ----------------
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",

      // Model routing: one primary plus an ordered fallback chain. OpenClaw
      // rotates auth profiles first, then advances down this chain
      // (see docs/concepts/model-failover.md).
      model: {
        primary: "openrouter/anthropic/claude-sonnet-4-6",
        fallbacks: [
          "openrouter/auto",
          "openrouter/deepseek/deepseek-v4-pro",
          "openrouter/meta-llama/llama-3.3-70b-instruct",
        ],
      },

      // Constrain which models a user may switch to in-session. Empty = any.
      modelPolicy: {
        allow: ["openrouter/*"],
      },
    },
  },

  // --- Plugins ------------------------------------------------------------
  // `tokenjuice` is the official OpenClaw token-reduction plugin (compacts
  // noisy exec/bash tool results before they re-enter the context window).
  // Install first:  openclaw plugins install clawhub:@openclaw/tokenjuice
  plugins: {
    entries: {
      tokenjuice: {
        enabled: true,
      },
    },
  },

  // --- Skills -------------------------------------------------------------
  skills: {
    limits: {
      // Cap how much of the system prompt the skills index may consume.
      maxSkillsPromptChars: 4000,
    },
  },

  // --- Observability ------------------------------------------------------
  logging: {
    level: "info",
    consoleLevel: "info",
    audit: { enabled: true },
  },

  // Opt out of the anonymous version check. Set true only if you want it.
  telemetry: {
    enabled: false,
  },
}
